# ==========================================
# CONFIGURACIÓN DE SUPABASE PARA LOVO CIERRE
# ==========================================
# Copia este archivo a .env para desarrollo local
# En Render, configura estas variables en el panel "Environment"

SUPABASE_URL=https://tu-proyecto-id.supabase.co
SUPABASE_ANON_KEY=tu-clave-anon-publica-de-supabase

# Puerto del servidor (Render lo asigna automáticamente)
PORT=3000

# Teléfono de destino oficial para el reporte de WhatsApp
WHATSAPP_PHONE=34678146956
